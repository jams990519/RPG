# === TELEGRAM BOT ===
# Obtén tu token con @BotFather en Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Tu Telegram user ID (para ser admin). Separa varios con comas.
ADMIN_IDS=123456789,987654321

# === DATABASE ===
# SQLite (default) o PostgreSQL
DATABASE_URL=sqlite:///bot_database.db
# Para PostgreSQL: postgresql://user:password@localhost:5432/bot_db

# === GAME CONFIG ===
DAILY_COINS=100
MIN_BET=10
MAX_BET=10000
COOLDOWN_SECONDS=3
START_COINS=500

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FILE=bot.log

# === ENVIRONMENT ===
ENVIRONMENT=development
DEBUG=False
